APP_NAME=PfCompara
APP_ENV=desenvolvimento
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# DATABASE_URL=postgresql+psycopg://pfcompara:pfcompara@localhost:5432/pfcompara
DATABASE_URL=sqlite:///./data/pfcompara.sqlite

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

OCR_PROVIDER=auto
OCR_LANGUAGE=por
TESSERACT_CMD=

MAX_UPLOAD_MB=30
STORAGE_PATH=./data
