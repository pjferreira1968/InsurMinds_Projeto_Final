APP_NAME=InsurMinds_Projeto_Final
APP_ENV=desenvolvimento
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# SQLite é o banco padrão e não exige instalação de servidor.
DATABASE_URL=sqlite:///./data/insurminds_projeto_final.sqlite
# Para PostgreSQL local, use o valor abaixo ou copie .env.postgres.example para .env.
# DATABASE_URL=postgresql+psycopg://insurminds_projeto_final:insurminds_projeto_final@localhost:5432/insurminds_projeto_final

# Ollama e o modelo abaixo devem estar instalados antes da validação do ambiente.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=1200
OLLAMA_KEEP_ALIVE=30m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

# Tesseract deve estar instalado com o idioma definido em OCR_LANGUAGE.
OCR_PROVIDER=auto
OCR_LANGUAGE=por
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=30
STORAGE_PATH=./data
